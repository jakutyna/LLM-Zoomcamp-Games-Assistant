      "id": 2,
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT COALESCE(SUM(cost_usd), 0)::double precision AS value FROM interactions WHERE $__timeFilter(created_at)", "refId": "A"}],
      "title": "Total cost",
      "type": "stat"
    },
    {
      "datasource": {"type": "postgres", "uid": "games-assistant-postgres"},
