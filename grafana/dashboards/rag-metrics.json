        "pieType": "pie",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT COUNT(*) FILTER (WHERE feedback = 1) AS Positive, COUNT(*) FILTER (WHERE feedback = -1) AS Negative FROM interactions WHERE $__timeFilter(created_at) AND feedback IS NOT NULL", "refId": "A"}],
      "title": "Feedback",
      "type": "piechart"
    },
    {
      "datasource": {"type": "postgres", "uid": "games-assistant-postgres"},
