      "id": 5,
      "targets": [{"format": "time_series", "rawQuery": true, "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), COUNT(*) AS calls FROM interactions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1", "refId": "A"}],
      "title": "Calls over time",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "games-assistant-postgres"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "targets": [{"format": "time_series", "rawQuery": true, "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), SUM(input_tokens) AS input_tokens, SUM(output_tokens) AS output_tokens FROM interactions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1", "refId": "A"}],
      "title": "Token usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "games-assistant-postgres"},
